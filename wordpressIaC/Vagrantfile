# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Box configuration
  config.vm.box = "ubuntu/focal64"
  config.vm.box_check_update = false

  # Increase boot timeout to 10 minutes
  config.vm.boot_timeout = 600

  # Private network
  config.vm.network "private_network", ip: "192.168.56.26"

  # Public network (bridged)
  config.vm.network "public_network"

  # Synced folders
  config.vm.synced_folder "../data", "/vagrant_data", create: true
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # VirtualBox provider settings
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "2048"
    vb.cpus = 4
  end

  # Provisioning script - WordPress Installation
  config.vm.provision "shell", inline: <<-SHELL
    # Update system packages
    apt-get update
    apt-get upgrade -y

    # Install Apache, PHP, MySQL, and dependencies
    apt-get install -y apache2 \
                       ghostscript \
                       libapache2-mod-php \
                       mysql-server \
                       php \
                       php-bcmath \
                       php-curl \
                       php-imagick \
                       php-intl \
                       php-json \
                       php-mbstring \
                       php-mysql \
                       php-xml \
                       php-zip \
                       curl \
                       wget \
                       git

    # Create WordPress directory
    mkdir -p /srv/www
    chown www-data: /srv/www

    # Download and extract WordPress
    curl https://wordpress.org/latest.tar.gz | sudo -u www-data tar zx -C /srv/www

    # Create Apache configuration for WordPress
    cat > /etc/apache2/sites-available/wordpress.conf <<'EOF'
<VirtualHost *:80>
    DocumentRoot /srv/www/wordpress
    <Directory /srv/www/wordpress>
        Options FollowSymLinks
        AllowOverride Limit Options FileInfo
        DirectoryIndex index.php
        Require all granted
    </Directory>
    <Directory /srv/www/wordpress/wp-content>
        Options FollowSymLinks
        Require all granted
    </Directory>
</VirtualHost>
EOF

    # Enable WordPress site and Apache modules
    a2ensite wordpress
    a2enmod rewrite
    a2dissite 000-default

    # Create WordPress database
    mysql -u root -e "CREATE DATABASE IF NOT EXISTS wordpress;"
    mysql -u root -e "CREATE USER IF NOT EXISTS wordpress@localhost IDENTIFIED BY 'admin123';"
    mysql -u root -e "GRANT SELECT,INSERT,UPDATE,DELETE,CREATE,DROP,ALTER ON wordpress.* TO wordpress@localhost;"
    mysql -u root -e "FLUSH PRIVILEGES;"

    # Configure WordPress
    sudo -u www-data cp /srv/www/wordpress/wp-config-sample.php /srv/www/wordpress/wp-config.php

    # Update wp-config.php with database credentials
    sudo -u www-data sed -i 's/database_name_here/wordpress/' /srv/www/wordpress/wp-config.php
    sudo -u www-data sed -i 's/username_here/wordpress/' /srv/www/wordpress/wp-config.php
    sudo -u www-data sed -i 's/password_here/admin123/' /srv/www/wordpress/wp-config.php

    # Restart services
    systemctl restart mysql
    systemctl restart apache2

    # Create log file
    echo "========================================" > /opt/wordpress-setup.log
    echo "WordPress Setup Completed" >> /opt/wordpress-setup.log
    date >> /opt/wordpress-setup.log
    echo "Database: wordpress" >> /opt/wordpress-setup.log
    echo "User: wordpress" >> /opt/wordpress-setup.log
    echo "Password: admin123" >> /opt/wordpress-setup.log
    echo "Access at: http://192.168.56.26" >> /opt/wordpress-setup.log
    echo "========================================" >> /opt/wordpress-setup.log
  SHELL

end
